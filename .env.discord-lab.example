# ==============================================================================
# G4X Community — Safe Live Discord Lab Environment Template (.env.discord-lab.example)
#
# INSTRUCTIONS FOR OPERATOR:
#  1. Copy this file OUTSIDE the repository, or to a local git-ignored file:
#       cp .env.discord-lab.example ../.env.discord-lab
#     OR:
#       cp .env.discord-lab.example .env.discord-lab.local
#  2. Fill in DISCORD_LAB_ALLOWED_GUILD_ID with the "G4X Staging Lab" Guild ID.
#  3. Fill in DISCORD_LAB_APPLICATION_ID with the "G4X Staging Bot" Application ID.
#  4. Fill in DISCORD_LAB_BOT_TOKEN with the test bot token.
#  5. NEVER commit your actual .env.discord-lab file to Git.
#  6. Run preflight checks before starting: npm run discord-lab:preflight
# ==============================================================================

# ─── 1. Opt-In & Environment Mode ─────────────────────────────────────────────
DISCORD_LAB_MODE=true
NODE_ENV=staging

# ─── 2. Local Loopback Host Binding ───────────────────────────────────────────
HOST=127.0.0.1
PORT=3001

# ─── 3. Dedicated Test Guild Allowlist (MANDATORY) ────────────────────────────
# Must be the exact Discord snowflake (17-20 digits) of your dedicated test server.
DISCORD_LAB_ALLOWED_GUILD_ID=

# Test bot Application ID
DISCORD_LAB_APPLICATION_ID=

# ─── 4. Test Bot Credential ───────────────────────────────────────────────────
# Keep this ONLY in your external/git-ignored file. Never paste into chat or commits.
DISCORD_LAB_BOT_TOKEN=

# ─── 5. Database Confinement ─────────────────────────────────────────────────
# Must point inside prisma/staging/. The runner will automatically provision
# isolated disposable SQLite files on startup.
DATABASE_URL=file:./staging/discord_lab.db

# ─── 6. Mandatory Safety Gates (ALL SIX MUST BE EXACTLY 'false') ──────────────
ESCROW_RELEASE_ENABLED=false
FINANCE_V2_LIVE_CREDITS_ENABLED=false
FINANCE_V2_LIVE_PAYOUTS_ENABLED=false
FINANCE_V2_P2P_SETTLEMENT_ENABLED=false
NOWPAYMENTS_LIVE_COLLECTION_ENABLED=false
RAIDERIO_LIVE_SYNC_ENABLED=false

# ─── 7. Payment Gateways (Disabled / Mock) ────────────────────────────────────
NOWPAYMENTS_MODE=disabled
NOWPAYMENTS_API_KEY=mock_np_key
ZARINPAL_MERCHANT_ID=mock_zp_key

# ─── 8. Local Cryptographic Secrets ──────────────────────────────────────────
# Must be at least 32 high-entropy characters in your local file.
SESSION_SECRET=replace_with_at_least_32_random_characters_in_your_local_file
G4X_OWNER_ACCESS_KEY=replace_with_at_least_32_random_characters_in_your_local_file
