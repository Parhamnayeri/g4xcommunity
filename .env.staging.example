# ─── G4X Community — Staging Environment Template (.env.staging.example) ───────
# Copy this file to .env.staging for local isolated staging runs.
# NEVER CONNECT TO PRODUCTION DISCORD, PRODUCTION SQLITE, OR REAL PAYMENT GATEWAYS.

# ─── Staging Operating Mode ──────────────────────────────────────────────────
NODE_ENV=development
STAGING_MODE=true
HOST=127.0.0.1
PORT=3001
WEB_BASE_URL=http://127.0.0.1:3001
PUBLIC_WEB_URL=http://127.0.0.1:3001
COOKIE_SECURE=false

# ─── Isolated Disposable Staging SQLite Database ─────────────────────────────
# Schema-relative: resolved by Prisma to <repoRoot>/prisma/staging/staging.db
DATABASE_URL="file:./staging/staging.db"

# ─── Simulated / Mock Discord Application ────────────────────────────────────
# In STAGING_MODE, live bot connection is strictly bypassed.
DISCORD_TOKEN=mock_staging_token_do_not_connect
DISCORD_CLIENT_ID=999999999999990099
DISCORD_CLIENT_SECRET=mock_staging_client_secret_do_not_use
DISCORD_GUILD_ID=999999999999990000
DISCORD_REDIRECT_URI=http://127.0.0.1:3001/auth/callback

# ─── Staging Discord Channels (Mock IDs) ─────────────────────────────────────
CHANNEL_ORDERS=999999999999991001
CHANNEL_APPLY_REQUESTS=999999999999991002
CHANNEL_BECOME_BOOSTER=999999999999991004
CHANNEL_BECOME_ADVERTISER=999999999999991005
CHANNEL_BECOME_PILOT=999999999999991006
CHANNEL_BECOME_EXCHANGER=999999999999991007
CHANNEL_APP_BOOSTERS=999999999999991008
CHANNEL_APP_ADVERTISERS=999999999999991009
CHANNEL_APP_PILOTS=999999999999991010
CHANNEL_APP_EXCHANGERS=999999999999991011

# ─── Staging Discord Role IDs (Mock IDs) ─────────────────────────────────────
ROLE_OWNER=999999999999992001
ROLE_ADMIN=999999999999992002
ROLE_MANAGER=999999999999992003
ROLE_STAFF=999999999999992004
ROLE_ADVERTISER=999999999999992005
ROLE_EXCHANGER=999999999999992006
ROLE_BOOSTER=999999999999992007
ROLE_PILOT=999999999999992008

# ─── Web Session Security ────────────────────────────────────────────────────
SESSION_SECRET=staging_session_secret_at_least_64_characters_random_hex_0123456789abcdef

# ─── Mandatory Financial & External Safety Gates (ALL MUST BE FALSE) ──────────
ESCROW_RELEASE_ENABLED=false
FINANCE_V2_LIVE_CREDITS_ENABLED=false
FINANCE_V2_LIVE_PAYOUTS_ENABLED=false
FINANCE_V2_P2P_SETTLEMENT_ENABLED=false
NOWPAYMENTS_LIVE_COLLECTION_ENABLED=false
RAIDERIO_LIVE_SYNC_ENABLED=false

# ─── Platform Holding & Escrow Rules ─────────────────────────────────────────
ESCROW_RELEASE_HOURS=24
G4X_BOOST_HOLD_HOURS=24

# ─── Booster Withdrawal Policies (Manual Payouts Only) ───────────────────────
BOOSTER_USDT_WITHDRAWAL_FEE_CENTS=40
BOOSTER_IRT_WITHDRAWAL_FEE_CENTS=130
BOOSTER_IRT_RATE_DISCOUNT_PER_USD=3000

# ─── Withdrawal & Exchange Quote Signing Secrets ─────────────────────────────
WITHDRAWAL_QUOTE_SIGNING_SECRET=staging_withdrawal_signing_secret_min_32_characters_random_hex_99
EXCHANGE_QUOTE_SIGNING_SECRET=staging_exchange_signing_secret_min_32_characters_random_hex_88
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# ─── Cryptocurrency Collection Controls (Disabled) ───────────────────────────
NOWPAYMENTS_MODE=disabled
NOWPAYMENTS_SANDBOX_ENABLED=false
NOWPAYMENTS_API_KEY=mock_staging_nowpayments_api_key_do_not_use
NOWPAYMENTS_IPN_SECRET=mock_staging_nowpayments_ipn_secret_do_not_use
NOWPAYMENTS_IPN_CALLBACK_URL=http://127.0.0.1:3001/api/webhooks/nowpayments

# ─── OwnerGate Authentication ────────────────────────────────────────────────
# High-entropy random secret without placeholders, length >= 32 chars, distinct chars >= 10
G4X_OWNER_ACCESS_KEY=g4x_staging_isolated_owner_key_48a9b2c7e1f3056d82c49b
OWNER_DISCORD_ID=999999999999990001

# ─── Frontend Branding Configuration ─────────────────────────────────────────
VITE_APP_LOGO_URL=
