{
  "name": "g4x-bot",
  "version": "1.0.0",
  "description": "G4X Community - Discord Bot & Web Portal",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "dev:watch": "nodemon --exec ts-node src/index.ts",
    "db:push": "prisma db push",
    "db:seed": "ts-node src/database/seed.ts",
    "db:studio": "prisma studio",
    "test:security": "ts-node src/test/security_auth_suite.ts",
    "test:escrow": "ts-node src/test/escrow_safety_suite.ts",
    "test:integrity": "ts-node src/test/wallet_ledger_integrity_suite.ts",
    "test:domain": "ts-node src/test/domain_service_suite.ts",
    "test:permissions": "ts-node src/test/permission_authorization_suite.ts",
    "test:registration": "ts-node src/test/discord_registration_suite.ts",
    "test:recovery": "ts-node src/test/registration_recovery_suite.ts",
    "test:bootstrap": "ts-node src/test/owner_bootstrap_suite.ts",
    "test:finance": "ts-node src/test/financial_calculation_suite.ts",
    "test:finance:v2": "ts-node src/test/finance_v2_suite.ts",
    "test:finance:v2:1": "ts-node src/test/finance_v2_1_hardening_suite.ts",
    "test:channels": "ts-node src/test/separate_registration_channels_suite.ts",
    "test:platform:reconciliation": "ts-node src/test/platform_balances_and_reconciliation_suite.ts",
    "test:platform": "ts-node src/test/platform_balances_and_reconciliation_suite.ts",
    "test": "ts-node src/test/financial_calculation_suite.ts && ts-node src/test/platform_balances_and_reconciliation_suite.ts && ts-node src/test/finance_v2_suite.ts && ts-node src/test/finance_v2_1_hardening_suite.ts",
    "bootstrap:owner": "ts-node scripts/bootstrap-owner.ts",
    "audit:policies": "ts-node scripts/audit-financial-policies.ts",
    "audit": "ts-node scripts/audit-financial-policies.ts",
    "finance:cli": "ts-node scripts/platform-finance-cli.ts",
    "export:clean-source": "ts-node scripts/export-clean-source.ts"
  },
  "prisma": {
    "seed": "ts-node src/database/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "axios": "^1.6.7",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-session": "^1.19.0",
    "js-sha3": "^0.13.0",
    "node-cron": "^3.0.3",
    "prisma": "6.19.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.11.5",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.3",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
