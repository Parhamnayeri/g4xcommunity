# ─── G4X Community — Environment Configuration Template (.env.example) ───────
# Copy this file to .env and configure your environment variables. Never commit .env!

# ─── Discord Bot Application ─────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_GUILD_ID=your_guild_id_here

# ─── Discord Channels ────────────────────────────────────────────────────────
CHANNEL_ORDERS=your_orders_channel_id
CHANNEL_APPLY_REQUESTS=your_private_review_channel_id
CHANNEL_LOGS=your_logs_channel_id

# ─── Dedicated Registration Channels (START HERE - Public Panels) ─────────────
CHANNEL_BECOME_BOOSTER=your_become_booster_channel_id
CHANNEL_BECOME_ADVERTISER=your_become_adv_channel_id
CHANNEL_BECOME_PILOT=your_become_pilot_booster_channel_id
CHANNEL_BECOME_EXCHANGER=your_become_exchanger_channel_id

# ─── Dedicated Application Management Channels (Private Review) ──────────────
CHANNEL_APP_BOOSTERS=your_app_boosters_channel_id
CHANNEL_APP_ADVERTISERS=your_app_adv_channel_id
CHANNEL_APP_PILOTS=your_app_pilots_channel_id
CHANNEL_APP_EXCHANGERS=your_app_exchangers_channel_id

# ─── Discord Role IDs ────────────────────────────────────────────────────────
ROLE_OWNER=your_owner_role_id
ROLE_MANAGER=your_manager_role_id
ROLE_ADMIN=your_admin_role_id
ROLE_STAFF=your_staff_role_id
ROLE_EXCHANGER=your_exchanger_role_id
ROLE_ADVERTISER=your_advertiser_role_id
ROLE_BOOSTER=your_booster_role_id
ROLE_PILOT=your_pilot_role_id

# ─── Web & Authentication Server ─────────────────────────────────────────────
HOST=0.0.0.0
# On Bot-Hosting.net production deployment, the assigned port is 26189. Locally default is 3000.
PORT=26189
NODE_ENV=production
WEB_BASE_URL=https://your-domain-or-host-url.com
SESSION_SECRET=generate_a_secure_random_64_character_hex_string_here
DISCORD_REDIRECT_URI=https://your-domain-or-host-url.com/auth/callback

# ─── SQLite Database ─────────────────────────────────────────────────────────
# In production (Bot-Hosting.net), point to persistent storage:
DATABASE_URL="file:../data/g4x_dev.db"

# ─── Platform & Financial Safety Rules (Finance V2) ──────────────────────────
# Production Financial Lock: Real-money payouts, wallet releases and automated settlements are DISABLED
ESCROW_RELEASE_ENABLED=false
FINANCE_V2_LIVE_CREDITS_ENABLED=false
FINANCE_V2_LIVE_PAYOUTS_ENABLED=false
FINANCE_V2_P2P_SETTLEMENT_ENABLED=false

# Legacy & Platform Base Rules
PLATFORM_FEE_RATE=0.10
DEFAULT_COMMISSION_RATE=0.15
PRESIGN_TIMER_MINUTES=10

# Finance V2: G4X Published Boost Release Policy
# 24-hour holding countdown begins strictly at Admin Final Approval timestamp
G4X_BOOST_HOLD_HOURS=24

# Finance V2: Booster Withdrawal Policies (Manual Payouts Only)
# Fixed booster fees: USDT $0.40 on BSC BEP-20 only; IRT $1.30 via Iranian Banking
BOOSTER_USDT_WITHDRAWAL_FEE_CENTS=40
BOOSTER_IRT_WITHDRAWAL_FEE_CENTS=130
BOOSTER_IRT_RATE_DISCOUNT_PER_USD=3000

# Finance V2: Advertiser Funding Policies
# Applied to manual Admin USD/IRT rate during IRT top-ups (e.g. 0.05 for 5%)
ADVERTISER_IRT_PURCHASE_FEE_RATE=0.05

# Finance V2: IRT Payout Scheduling
# Timezone offset in hours (UTC+3.5 for Iran Standard Time)
IRT_PAYOUT_TIMEZONE_OFFSET=3.5
# Tuesday morning cutoff hour (must be explicitly approved and configured; missing value blocks automated scheduling)
IRT_PAYOUT_TUESDAY_CUTOFF_HOUR=10

# Finance V2: Withdrawal & Exchange Quote Signing & Blockchain RPC Oracles
# Dedicated HMAC signing key for withdrawal quotes (strictly required, min 32 chars, high entropy)
WITHDRAWAL_QUOTE_SIGNING_SECRET=generate_a_secure_random_64_character_hex_string_here
# Dedicated HMAC signing key for Exchange & P2P quotes (strictly required, min 32 chars, high entropy)
EXCHANGE_QUOTE_SIGNING_SECRET=generate_a_secure_random_64_character_hex_string_here
# Dedicated BSC RPC endpoint for authoritative on-chain verification of BEP-20 payouts (Mainnet Chain ID 56)
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# ─── NOWPayments Cryptocurrency Collection Controls ──────────────────────────
# Provider mode: 'disabled' | 'sandbox' | 'live'. Default must be disabled.
NOWPAYMENTS_MODE=disabled
# Safety gates: must be explicitly true to allow sandbox or live payments
NOWPAYMENTS_SANDBOX_ENABLED=false
NOWPAYMENTS_LIVE_COLLECTION_ENABLED=false
# Provider credentials (keep secret, never commit real keys)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here
# Public HTTPS callback URL for IPN webhook on Bot-Hosting.net or reverse proxy
NOWPAYMENTS_IPN_CALLBACK_URL=https://your-domain-or-host-url.com/api/webhooks/nowpayments

# ─── OwnerGate Authentication ────────────────────────────────────────────────
# High-entropy, cryptographically random secret (min 32 characters, high entropy)
# Required for emergency or dedicated access key login at /OwnerGate
G4X_OWNER_ACCESS_KEY=your_high_entropy_random_owner_access_key_min_32_chars_here
