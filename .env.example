# ==============================================================================
# G4X Community — Production Environment Configuration Template (.env.example)
# Version: v1.0.0
#
# INSTRUCTIONS:
#  1. Copy this file to .env in your root directory:
#       cp .env.example .env
#  2. Fill in your Discord Bot credentials from the Discord Developer Portal.
#  3. Generate high-entropy 64-character random secrets using Node.js:
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  4. NEVER commit .env to GitHub or share secrets publicly!
# ==============================================================================

# ─── 1. Core Server & Public Web URLs ─────────────────────────────────────────
# Operating environment ('production' for live deployments, 'development' for local)
# Required | Default: production
NODE_ENV=production

# Internal web server binding port (Linode VPS default: 3001 behind Nginx reverse proxy)
# Required | Default: 3001
PORT=3001

# Web server network interface binding ('127.0.0.1' for security behind reverse proxy)
# Required | Default: 127.0.0.1
HOST=127.0.0.1

# Canonical public HTTPS base URL for portal users and Discord webhook callbacks
# Required | Example: https://g4x.online
WEB_BASE_URL=https://g4x.online

# Canonical public web URL used by Discord DM notifications (e.g. direct KYC links)
# Required | Example: https://g4x.online
PUBLIC_WEB_URL=https://g4x.online

# Enforce secure HTTPS-only session cookies (set true in production with SSL)
# Required | Default: true
COOKIE_SECURE=true

# Discord OAuth2 callback redirect URL (must match Discord Developer Portal redirect URIs)
# Required | Example: https://g4x.online/auth/callback
DISCORD_REDIRECT_URI=https://g4x.online/auth/callback

# Public Discord server invite link displayed on landing and help pages
# Optional | Example: https://discord.gg/g4xcommunity
DISCORD_INVITE_URL=https://discord.gg/your_invite_link


# ─── 2. Database (Prisma SQLite) ──────────────────────────────────────────────
# SQLite database connection URL. Point to a persistent file location in production.
# Required | Default: "file:./prisma/prod.db"
DATABASE_URL="file:./prisma/prod.db"


# ─── 3. Discord Bot, OAuth2 & Automatic Channel Provisioning ──────────────────
# Primary Discord Bot Token (from Discord Developer Portal > Bot > Token)
# Required | Keep secret
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord Application / Client ID (from Developer Portal > General Information)
# Required | 17-20 digit snowflake
DISCORD_CLIENT_ID=your_client_id_here

# Discord Application Client Secret (for OAuth2 web authentication)
# Required | Keep secret
DISCORD_CLIENT_SECRET=your_client_secret_here

# Target Discord Server (Guild) Snowflake ID
# Required | 17-20 digit snowflake
DISCORD_GUILD_ID=your_guild_id_here

# Primary Platform Owner Discord Snowflake ID (for OwnerGate and executive actions)
# Required | 17-20 digit snowflake
OWNER_DISCORD_ID=your_owner_discord_user_id_here

# ─── Channel & Category Overrides (Optional — Auto-provisioned by default) ────
# Note: The bot will automatically create and synchronize missing channels and
# categories using `discordProvisioningService` if these variables are omitted.

# Orders Board Channel ID
# Optional
CHANNEL_ORDERS=

# Fallback Staff Private Review Channel ID
# Optional
CHANNEL_APPLY_REQUESTS=

# Category IDs for Dynamic Order Rooms:
# Optional
CATEGORY_ORDERS=
CATEGORY_ACTIVE_ORDERS=
CATEGORY_EXECUTION_ORDERS=

# Public Registration Panels ("START HERE" category):
# Optional
CHANNEL_BECOME_BOOSTER=
CHANNEL_BECOME_ADVERTISER=
CHANNEL_BECOME_PILOT=
CHANNEL_BECOME_EXCHANGER=

# Private Staff Review Channels ("APPLICATION MANAGEMENT" category):
# Optional
CHANNEL_APP_BOOSTERS=
CHANNEL_APP_ADVERTISERS=
CHANNEL_APP_PILOTS=
CHANNEL_APP_EXCHANGERS=

# Discord Server Role IDs (Mapped to G4X permissions):
# Optional | Snowflakes
ROLE_OWNER=
ROLE_MANAGER=
ROLE_ADMIN=
ROLE_STAFF=
ROLE_EXCHANGER=
ROLE_ADVERTISER=
ROLE_BOOSTER=
ROLE_PILOT=


# ─── 4. Security & Cryptography Keys ──────────────────────────────────────────
# Express web session encryption secret (minimum 64 characters random hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required | High entropy
SESSION_SECRET=replace_with_secure_random_64_character_hex_session_secret

# Emergency access key for /OwnerGate login (minimum 32 characters, high entropy)
# Required | Keep secret
G4X_OWNER_ACCESS_KEY=replace_with_secure_random_32_character_hex_owner_key

# HMAC key for cryptographic signing of booster withdrawal quotes (anti-tamper)
# Required | Minimum 32 characters
WITHDRAWAL_QUOTE_SIGNING_SECRET=replace_with_secure_random_32_character_withdrawal_secret

# HMAC key for cryptographic signing of P2P / Exchanger marketplace quotes
# Required | Minimum 32 characters
EXCHANGE_QUOTE_SIGNING_SECRET=replace_with_secure_random_32_character_exchange_secret


# ─── 5. Finance V2 & Live USDT Payouts ─────────────────────────────────────────
# Enable live USDT withdrawals approval and payout processing queue
# Required | Default: true (for operational payouts)
FINANCE_V2_LIVE_PAYOUTS_ENABLED=true

# Safety Gate: Live wallet balance credits from payment processors (keep false until live)
# Required | Default: false
FINANCE_V2_LIVE_CREDITS_ENABLED=false

# Safety Gate: Automated P2P settlement transfers (keep false until live)
# Required | Default: false
FINANCE_V2_P2P_SETTLEMENT_ENABLED=false

# Safety Gate: Automatic escrow release after hold period
# Required | Default: false
ESCROW_RELEASE_ENABLED=false

# Order escrow hold duration in hours before automatic release
# Required | Default: 24
ESCROW_RELEASE_HOURS=24

# Booster earnings hold window in hours post Admin Final Approval
# Required | Default: 24
G4X_BOOST_HOLD_HOURS=24

# Fixed withdrawal fee for USDT on Binance Smart Chain (BEP-20) in USD cents (40 = $0.40)
# Required | Default: 40
BOOSTER_USDT_WITHDRAWAL_FEE_CENTS=40

# Fixed withdrawal fee for IRT bank transfers in USD cents (130 = $1.30)
# Required | Default: 130
BOOSTER_IRT_WITHDRAWAL_FEE_CENTS=130

# IRT exchange discount rate per USD in Iranian Tomans
# Required | Default: 3000
BOOSTER_IRT_RATE_DISCOUNT_PER_USD=3000

# Binance Smart Chain (BSC) RPC endpoint for on-chain payout transaction verification
# Required | Default: https://bsc-dataseed.binance.org/
BSC_RPC_URL=https://bsc-dataseed.binance.org/


# ─── 6. Google Drive Hybrid Backup & Restore (rclone) ─────────────────────────
# Enable automatic scheduled database snapshot backups to Google Drive
# Required | Default: true in production (requires rclone configured)
GDRIVE_BACKUP_ENABLED=true

# Backup execution frequency in hours (runs every N hours)
# Required | Default: 6
GDRIVE_BACKUP_INTERVAL_HOURS=6

# Name of the configured rclone remote pointing to your 5TB Google Drive account
# Required | Default: gdrive
GDRIVE_RCLONE_REMOTE=gdrive

# Root destination folder inside Google Drive where backups will be stored
# Required | Default: G4X-Backups
GDRIVE_BACKUP_FOLDER=G4X-Backups

# Retention period in days; remote database snapshots older than N days are auto-pruned
# Required | Default: 60
BACKUP_RETENTION_DAYS=60

# Optional custom path to the rclone binary (if not located in system PATH)
# Optional | Default: rclone
# RCLONE_PATH=/usr/bin/rclone


# ─── 7. External Integrations & Optional Tuning ───────────────────────────────
# NOWPayments provider mode: 'disabled' | 'sandbox' | 'live'
# Required | Default: disabled
NOWPAYMENTS_MODE=disabled

# Safety gates for NOWPayments testing and live transactions
# Required | Default: false
NOWPAYMENTS_SANDBOX_ENABLED=false
NOWPAYMENTS_LIVE_COLLECTION_ENABLED=false

# NOWPayments API credentials (leave blank if disabled)
# Optional
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=https://g4x.online/api/webhooks/nowpayments

# Raider.IO API integration (disabled by default to comply with commercial TOS)
# Required | Default: false
RAIDERIO_LIVE_SYNC_ENABLED=false

# Optional custom brand logo image URL (falls back to native SVG if omitted)
# Optional | Default: native SVG mark
VITE_APP_LOGO_URL=
