# ==============================================================================
# G4X Community — Operational Closed Beta Environment Template (.env.beta.example)
# Version: v0.001
#
# INSTRUCTIONS FOR OPERATOR:
#  1. Copy this template to a local, git-ignored file:
#       cp .env.beta.example .env.beta.local
#  2. Generate strong cryptographic secrets locally using Node.js:
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#     Assign unique outputs to SESSION_SECRET, G4X_OWNER_ACCESS_KEY, and
#     WITHDRAWAL_QUOTE_SIGNING_SECRET.
#  3. Add invited Discord User IDs (17-20 digit snowflakes) to BETA_INVITE_ALLOWLIST_IDS.
#  4. NEVER commit .env.beta.local or share its secret values.
#  5. For web-only preflight testing, run:
#       npm run beta:start -- --no-discord
# ==============================================================================

# ─── 1. Beta Operating Mode ───────────────────────────────────────────────────
NODE_ENV=development
BETA_MODE=true
DISCORD_LAB_MODE=false

# ─── 2. Local Loopback Host Binding ───────────────────────────────────────────
# Closed Beta v0.001 strictly forbids public wildcard bindings (0.0.0.0 or ::).
# Bind strictly to loopback 127.0.0.1 or a private VPN/Tailscale interface.
BETA_HOST=127.0.0.1
BETA_PORT=3002
HOST=127.0.0.1
PORT=3002
WEB_BASE_URL=http://127.0.0.1:3002
PUBLIC_WEB_URL=http://127.0.0.1:3002
COOKIE_SECURE=false

# ─── 3. Persistent Beta SQLite Database ───────────────────────────────────────
# Must point inside prisma/staging/. Default is prisma/staging/beta_v0001.db
# Unlike disposable Discord Lab databases, this database is PERSISTENT across restarts.
DATABASE_URL=file:./staging/beta_v0001.db

# ─── 4. Discord Bot & OAuth2 Containment ──────────────────────────────────────
# For web-only preflight testing without Discord, set BETA_DISCORD_ENABLED='false'.
# When enabling Discord Bot, supply your bot token and target server:
BETA_DISCORD_ENABLED=true
BETA_OAUTH_ENABLED=false

# Discord Bot Credentials
BETA_BOT_TOKEN=
BETA_ALLOWED_GUILD_ID=1569816836948889730
BETA_APPLICATION_ID=1569816469200441344

# Standard Aliases supported for convenience:
DISCORD_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1569816836948889730
DISCORD_CLIENT_ID=1569816469200441344

# ─── 5. Closed Beta Allowlist (Invite-Only) ───────────────────────────────────
# Comma-separated Discord User IDs (17-20 digit snowflakes) permitted to access.
# Replace placeholder with authorized operator / beta tester Discord snowflakes.
BETA_INVITE_ALLOWLIST_IDS=100000000000000001
OWNER_DISCORD_ID=100000000000000001

# ─── 6. Financial & External Safety Gates ─────────────────────────────────────
# FINANCE_V2_LIVE_PAYOUTS_ENABLED=true allows end-to-end testing of USDT withdrawal approval queue
ESCROW_RELEASE_ENABLED=false
ESCROW_RELEASE_HOURS=24
FINANCE_V2_LIVE_CREDITS_ENABLED=false
FINANCE_V2_LIVE_PAYOUTS_ENABLED=true
FINANCE_V2_P2P_SETTLEMENT_ENABLED=false
NOWPAYMENTS_LIVE_COLLECTION_ENABLED=false
RAIDERIO_LIVE_SYNC_ENABLED=false

# ─── 7. Cryptocurrency & Fiat Payment Gates (Disabled) ────────────────────────
NOWPAYMENTS_MODE=disabled

# ─── 8. Local Cryptographic Secrets ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET must be >= 24 chars
SESSION_SECRET=replace_with_locally_generated_random_secret_at_least_32_characters
# G4X_OWNER_ACCESS_KEY must be >= 16 chars
G4X_OWNER_ACCESS_KEY=replace_with_locally_generated_owner_key_at_least_24_characters
# WITHDRAWAL_QUOTE_SIGNING_SECRET must be >= 32 chars (never use default placeholder)
WITHDRAWAL_QUOTE_SIGNING_SECRET=replace_with_locally_generated_withdrawal_secret_min_32_chars
# EXCHANGE_QUOTE_SIGNING_SECRET must be >= 32 chars
EXCHANGE_QUOTE_SIGNING_SECRET=replace_with_locally_generated_exchange_secret_min_32_chars

# ─── 9. Google Drive & rclone Production Backup & Disaster Recovery ───────────
GDRIVE_BACKUP_ENABLED=false
GDRIVE_BACKUP_INTERVAL_HOURS=6
GDRIVE_RCLONE_REMOTE=gdrive
GDRIVE_BACKUP_FOLDER=G4X-Backups
BACKUP_RETENTION_DAYS=60
# RCLONE_PATH=rclone

